# Edit these if your host uses different locations for these libraries.
HOST_DRI_DIR=/usr/lib/dri
HOST_LIBGL=/usr/lib/libGL.so.1
HOST_LIBDRM=/usr/lib/libdrm.so.2
HOST_LIBEGL=/usr/lib/libEGL.so.1
REPO_DIR=${PWD}/../
SSH_DIR=${HOME}/.ssh
REPO=Tirith
CACHE_DIR=~/.cache
MESA_DIR=${HOME}/.cache/Tirith/mesa
# These will be picked up from your environment by default; override if needed
DISPLAY=${DISPLAY}
XDG_RUNTIME_DIR=
