diff --git a/src/backends/unix/shared/hunk.c b/src/backends/unix/shared/hunk.c
index f1443ed8..fa713792 100644
--- a/src/backends/unix/shared/hunk.c
+++ b/src/backends/unix/shared/hunk.c
@@ -115,8 +115,12 @@ Hunk_End(void)
 {
 	byte *n = NULL;
 
+  Com_Printf("Hunk_End: allocated %zu bytes\n", curhunksize);
+
 #if defined(__linux__)
 	n = (byte *)mremap(membase, maxhunksize, curhunksize + sizeof(size_t), 0);
+  Com_Printf("Hunk_End: remapped from %zu to %zu bytes\n", maxhunksize, curhunksize + sizeof(size_t));
+  Com_Printf("Hunk_End: mremap returned %p\n", n);
 #elif defined(__NetBSD__)
 	n = (byte *)mremap(membase, maxhunksize, NULL, curhunksize + sizeof(size_t), 0);
 #else
@@ -147,10 +151,13 @@ Hunk_End(void)
 
 	if (n != membase)
 	{
+    Com_Printf("Hunk_End: remap failed, returned %p expected %p\n", n, membase);
 		Sys_Error("Hunk_End: Could not remap virtual block (%d)", errno);
 	}
 
+  Com_Printf("Hunk_End: remap successful\n");
 	*((size_t *)membase) = curhunksize + sizeof(size_t);
+  Com_Printf("Hunk_End: final size %zu bytes\n", curhunksize);
 
 	return curhunksize;
 }
