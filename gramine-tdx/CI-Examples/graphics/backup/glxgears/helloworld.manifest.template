# Hello World manifest file example

libos.entrypoint = "/usr/bin/glxgears"
loader.log_level = "{{ log_level }}"

loader.env.LD_LIBRARY_PATH = "/lib:/usr/lib"
loader.env.HOME = "/home/adil"
loader.env.USER = "adil"
loader.env.DISPLAY="2:0"
loader.env.IVSHMEM_GRAMINE_VM="1"
# loader.env.LIBGL_ALWAYS_SOFTWARE="1"
#loader.env.SGL_NETWORK_ENDPOINT="192.168.12.112:6000"
# loader.env.Xauthority = "/home/gramine/.Xauthority"

loader.insecure__use_host_env = true

fs.mounts = [
  { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
  { path = "/usr/lib/libX11.so.6", uri = "file:/usr/lib/libX11.so.6" },
  { path = "/usr/lib/libxcb.so.1", uri = "file:/usr/lib/libxcb.so.1" },
  { path = "/usr/lib/libXau.so.6", uri = "file:/usr/lib/libXau.so.6" },
  { path = "/usr/lib/libXdmcp.so.6", uri = "file:/usr/lib/libXdmcp.so.6" },
  { path = "/usr/lib/libGL.so.1", uri = "file:/home/adil/Projects/gramine-tdx-testing/sharedgl/build/libGL.so.1" },
  { path = "/usr/bin/glxgears", uri = "file:/usr/bin/glxgears" },
]

sgx.debug = true
sgx.edmm_enable = {{ 'true' if env.get('EDMM', '0') == '1' else 'false' }}

sgx.trusted_files = [
  "file:glxgears",
  "file:{{ gramine.runtimedir() }}/",
]
